# ⭐ CONFIGURAÇÃO DO BANCO DE DADOS ⭐

# Para SQLite (padrão - não precisa alterar nada)
DATABASE_URL=sqlite:///./movie_app.db

# Para PostgreSQL - DESCOMENTE A LINHA ABAIXO:
# DATABASE_URL=postgresql://username:password@localhost:5432/movie_db

# Para PostgreSQL com Docker - DESCOMENTE A LINHA ABAIXO:
# DATABASE_URL=postgresql://movie_user:movie_password@localhost:5432/movie_db